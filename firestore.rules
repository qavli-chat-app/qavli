rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isChatMember(chatId) {
      return signedIn()
        && chatData(chatId).members is list
        && request.auth.uid in chatData(chatId).members;
    }

    function validText(field, max) {
      return request.resource.data.get(field, '') is string
        && request.resource.data.get(field, '').size() <= max;
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40;

      allow update: if isSelf(uid)
        && request.resource.data.username == resource.data.username
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'avatarUrl', 'online', 'lastSeen'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40;

      allow delete: if false;
    }

    // FCM web-push tokens are private to their owner.
    match /users/{uid}/notificationTokens/{tokenId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['token', 'link', 'updatedAt']);
      allow delete: if isSelf(uid);
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$');
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      // Safe for deterministic DM existence checks and group invite loading.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId))
        || request.auth.uid in resource.data.members
        || resource.data.isGroup == true
      );

      // Home query is constrained to chats containing the current UID.
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 100
        && request.auth.uid in request.resource.data.members
        && request.resource.data.isGroup is bool
        && (
          request.resource.data.isGroup == false
          || (
            request.resource.data.createdBy == request.auth.uid
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 60
          )
        );

      allow update: if signedIn() && (
        // Members may update only chat activity metadata.
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastActivityAt', 'lastMessage'])
          && request.resource.data.get('lastMessage', '').size() <= 120)
        ||
        // Only the group creator may change the member list.
        (request.auth.uid in resource.data.members
          && resource.data.isGroup == true
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 1
          && request.resource.data.members.size() <= 100)
        ||
        // A non-member can join a group only by adding their own UID.
        (resource.data.isGroup == true
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
          && request.resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size() + 1)
      );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt is timestamp
          && validText('text', 2000)
          && request.resource.data.get('fileName', '') is string
          && request.resource.data.get('fileName', '').size() <= 255
          && request.resource.data.get('fileType', '') is string
          && request.resource.data.get('fileType', '').size() <= 120
          && request.resource.data.get('fileUrl', '') is string
          && request.resource.data.get('fileUrl', '').size() <= 2048
          && request.resource.data.get('imageUrl', '') is string
          && request.resource.data.get('imageUrl', '').size() <= 2048
          && request.resource.data.get('replyTo', {}) is map
          && request.resource.data.get('replyTo', {}).get('id', '') is string
          && request.resource.data.get('replyTo', {}).get('id', '').size() <= 200
          && request.resource.data.get('replyTo', {}).get('text', '') is string
          && request.resource.data.get('replyTo', {}).get('text', '').size() <= 200;

        allow update: if isChatMember(chatId) && (
          // Only the original sender can edit/soft-delete their message.
          (resource.data.senderId == request.auth.uid
            && request.resource.data.senderId == resource.data.senderId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'edited', 'deleted'])
            && validText('text', 2000))
          ||
          // Members may update reaction/read-receipt metadata only.
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reaction', 'readBy'])
            && request.resource.data.get('reaction', '') is string
            && request.resource.data.get('reaction', '').size() <= 16)
        );

        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if isChatMember(chatId);
        allow create, update: if isChatMember(chatId)
          && request.auth.uid == uid
          && request.resource.data.until is timestamp;
        allow delete: if isChatMember(chatId) && request.auth.uid == uid;
      }
    }
  }
}